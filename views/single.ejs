<!doctype html>
<html lang="en">

<head>
  <!-- Required meta tags -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

  <!-- Bootstrap CSS -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css"
    integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">

  <title>Youtube Music Playlist Downloader</title>
  <style>
    .status span {
      display: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
    }

    .status .pending {
      background-color: transparent;
    }

    .status .success {
      background-color: green;
    }

    .status .error {
      background-color: red;
    }

    .list-group-item-warning .status .pending {
      display: inline-block;
      border-radius: 50%;
      width: 32px;
      height: 32px;
      border: 4px solid #fff;
      border-top: 4px solid rgba(255, 255, 255, 0.3);
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      0% {
        transform: rotate(0deg);
      }

      100% {
        transform: rotate(360deg);
      }
    }

    .list-group-item-success .status .success {
      display: inline-block;
    }

    .list-group-item-danger .status .error {
      display: inline-block;
    }
  </style>
</head>

<body>
  <%- include('partials/navbar') %>

    <div class="container mt-5">
      <div class="row justify-content-center">
        <div class="col-md-8 text-center">
          <h1 class="display-4 mb-3">Welcome to Youtube Music Playlist Downloader</h1>
          <p class="lead mb-4">Easily download your favorite YouTube Music playlists. Enter the playlist URL below to
            get started!</p>
          <form action="/single-form" method="POST" class="form-inline justify-content-center">
            <div class="form-group mb-2 mr-2 flex-grow-1" style="min-width:300px;">
              <input type="url" class="form-control w-100" name="url" placeholder="Enter YouTube Music URL" required
                pattern="https://(music\.)?youtube\.com/watch\?v=.+">
            </div>
            <div class="form-group mb-2 mr-2 flex-grow-1" style="min-width:300px;">
              <input type="text" class="form-control w-100" name="directoryName" id="directoryName"
                placeholder="Enter Custom Directory Name (Optional)">
            </div>
            <div class="form-group mb-2 mr-2 flex-grow-1" style="min-width:300px;">
              <input type="text" class="form-control w-100" name="name"
                placeholder="Enter Song Name (Optional. Falls back to YouTube Title)">
            </div>
            <button type="submit" class="btn btn-primary mb-2">Download</button>
          </form>
          <div class="mt-4 alert alert-info" role="alert">
            <strong>Example Music URL:</strong><br>
            <code>https://music.youtube.com/watch?v=DgdqPbV2fps</code>
          </div>

          <ul id="downloadsList" class="list-group mt-4"></ul>
        </div>
      </div>
    </div>

    <!-- Optional JavaScript -->
    <!-- jQuery first, then Popper.js, then Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"
      integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n"
      crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"
      integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo"
      crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js"
      integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6"
      crossorigin="anonymous"></script>

    <script>
      const eventSource = new EventSource('/sse');
      const downloadsList = document.getElementById('downloadsList');

      eventSource.onmessage = function (event) {
        const data = JSON.parse(event.data);
        let listItem = document.getElementById(data.id);

        if (!listItem && (data.status === "downloading" || data.status === "error" || data.status === "downloaded")) {
          listItem = document.createElement('li');
          listItem.id = data.id;
          listItem.className = "list-group-item d-flex align-items-center list-group-item-warning";
          listItem.innerHTML = `
             <div class="text-left" style="overflow: hidden;">
               <strong>${data.title}</strong><br>
               <small>Video ID: ${data.id}</small>
             </div>
             <div class="ml-auto status pl-2">
               <span class="pending"></span>
               <span class="success">✅</span>
               <span class="error">❌</span>
             </div>
           `;
          downloadsList.appendChild(listItem);
        }

        if (listItem) {
          if (data.status === "downloading") {
            listItem.className = "list-group-item d-flex align-items-center list-group-item-warning";
          } else if (data.status === "downloaded") {
            listItem.className = "list-group-item d-flex align-items-center list-group-item-success";
          } else if (data.status === "error") {
            listItem.className = "list-group-item d-flex align-items-center list-group-item-danger";
          }
        }
      };

      document.addEventListener('DOMContentLoaded', () => {
        const directoryInput = document.getElementById('directoryName');
        const form = document.querySelector('form[action="/single-form"]');

        const savedDir = localStorage.getItem('ytm-downloader-dir');
        if (savedDir) {
          directoryInput.value = savedDir;
        }

        form.addEventListener('submit', (e) => {
          e.preventDefault();
          localStorage.setItem('ytm-downloader-dir', directoryInput.value);

          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());

          fetch('/single-form', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data),
          }).then(res => {
            if (res.ok) {
              form.querySelector('input[name="url"]').value = '';
              form.querySelector('input[name="name"]').value = '';
            }
          }).catch(err => {
            console.error("Failed to submit form", err);
          });
        });
      });
    </script>
</body>

</html>